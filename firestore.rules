rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Family/admin allowlist. Add more emails here as needed and redeploy
    // with `firebase deploy --only firestore:rules`.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'yaduonline@gmail.com'
      ];
    }

    function isInvited(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/invitees/$(request.auth.token.email.lower()));
    }

    // RSVPs close once the event starts. Events with no date never close.
    function rsvpWindowOpen(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return event.date == null || event.date > request.time;
    }

    function isEventOpen(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.isOpen == true;
    }

    // Whether the caller has RSVP'd to this event themselves. RSVP documents
    // are keyed by lowercased email (not uid), so a signed-in user "owns"
    // the one matching their verified address. Content-independent (same
    // check for every doc in the collection), so it's safe in a `list` rule.
    function hasRsvpd(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.token.email.lower()));
    }

    function ownsRsvp(emailKey) {
      return isSignedIn() && request.auth.token.email.lower() == emailKey;
    }

    // Anyone - signed in or not - can create an RSVP on an open event, so
    // this is the only thing standing between the public internet and the
    // contents of that document. A strict whitelist of fields, types, and
    // sizes is enforceable in a way volume limits are not (see the comment
    // on the rsvps match block), so it's where the guarding effort goes.
    function validRsvpPayload(emailKey) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'email', 'name', 'firstName', 'lastName', 'status',
          'guestCount', 'adultCount', 'childCount', 'comment', 'respondedAt'
        ]) &&
        d.email is string && d.email.lower() == emailKey && d.email.size() <= 254 &&
        d.status in ['yes', 'no', 'maybe'] &&
        d.guestCount is int && d.guestCount >= 1 && d.guestCount <= 50 &&
        d.firstName is string && d.firstName.size() <= 100 &&
        d.lastName is string && d.lastName.size() <= 100 &&
        d.name is string && d.name.size() <= 200 &&
        d.comment is string && d.comment.size() <= 1000 &&
        (d.adultCount == null ||
          (d.adultCount is int && d.adultCount >= 0 && d.adultCount <= 50)) &&
        (d.childCount == null ||
          (d.childCount is int && d.childCount >= 0 && d.childCount <= 50));
    }

    // Whether the signed-in caller created this event. Used for `invitees`/
    // `rsvps` list rules so an owner can manage their own event the same
    // way admin can (a get() on the parent event, not per-document content).
    function isEventOwner(eventId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.createdByUid == request.auth.uid;
    }

    // Non-admin event creation is capped at 10 per rolling 24h window,
    // tracked in eventCounts/{uid}. Allowed if the counter doesn't exist
    // yet, the window has expired, or the count hasn't hit the cap.
    function underDailyEventLimit() {
      let path = /databases/$(database)/documents/eventCounts/$(request.auth.uid);
      return !exists(path) ||
        request.time > get(path).data.windowStart + duration.value(24, 'h') ||
        get(path).data.count < 10;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Lightweight public copy of events marked isOpen: true, kept in sync by
    // admin.js, so regular users can browse them without a full `events` list
    // query (Firestore rules can't grant `list` on a collection whose
    // per-document access depends on document content).
    match /openEvents/{eventId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Per-user index of "events I've RSVP'd to", written alongside the real
    // RSVP doc (events/*/rsvps/{uid}) so a signed-in user can find and edit
    // their past RSVPs without needing the original invite link again.
    match /userRsvps/{uid}/items/{eventId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Per-user index of "events I created" - same rationale as userRsvps,
    // powers the "Your events" list on my-events.html without needing a
    // full `events` list grant (admin-only).
    match /userEvents/{uid}/items/{eventId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Rolling 24h/10-event rate-limit counter for non-admin event creation.
    // Caller can only touch their own doc; increments must be by exactly 1
    // within a window, or a reset to 1 with a server-set windowStart once
    // the prior window has genuinely expired (so a client can't fabricate
    // an old window to dodge the cap).
    match /eventCounts/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.count == 1;
      allow update: if isSignedIn() && request.auth.uid == uid && (
        (request.resource.data.count == resource.data.count + 1 &&
          request.resource.data.windowStart == resource.data.windowStart) ||
        (request.resource.data.count == 1 &&
          request.time > resource.data.windowStart + duration.value(24, 'h') &&
          request.resource.data.windowStart == request.time)
      );
    }

    match /events/{eventId} {
      // Event details (title/date/location/description) are readable by
      // anyone holding the direct link - same model as Evite/Google
      // Calendar invite links. The invitee list stays admin-only; RSVP
      // responses are visible to admins, the event's own creator, and
      // anyone who has RSVP'd themselves (see hasRsvpd()) - not to the
      // general public.
      allow get: if true;
      allow list: if isAdmin();
      // Any signed-in user may create an event (not just admin); it must
      // be attributed to the caller, and non-admins are rate-limited.
      allow create: if isSignedIn() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.createdBy == request.auth.token.email &&
        (isAdmin() || underDailyEventLimit());
      // Admin, or the event's own creator, can update/delete it.
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.createdByUid == request.auth.uid);

      match /invitees/{email} {
        allow read, write: if isAdmin() || isEventOwner(eventId);
      }

      // Keyed by lowercased email rather than uid, so a first-time guest can
      // RSVP to an open event without an account at all. Firestore only
      // applies `create` when the document doesn't already exist, which is
      // precisely the "one RSVP per email address" rule - a second attempt
      // on the same address lands on `update` instead and is refused unless
      // the caller has proven they own that address.
      //
      // Deliberately NOT volume-rate-limited here: with no uid to key on, a
      // counter would have to be per-event and writable by anyone, so an
      // attacker could inflate it to the cap and lock everyone out of
      // RSVPing. That turns a low-probability spam risk into a trivial
      // denial-of-service, which is strictly worse. The enforceable guards
      // are the payload whitelist above (junk content) and, for the mail
      // account specifically, a send throttle inside the Cloud Function
      // (see functions/index.js), which no client can forge or exhaust.
      match /rsvps/{emailKey} {
        allow get: if ownsRsvp(emailKey) || isAdmin() || isEventOwner(eventId);
        allow list: if isAdmin() || hasRsvpd(eventId) || isEventOwner(eventId);

        // Open events: anyone may create a first RSVP, no sign-in needed.
        // Invite-only events still require a verified, invited account -
        // their whole gate is "is your address on the list", which means
        // nothing if an anonymous caller can simply claim to be that address.
        allow create: if rsvpWindowOpen(eventId) &&
          validRsvpPayload(emailKey) && (
            isEventOpen(eventId) ||
            (ownsRsvp(emailKey) && isInvited(eventId))
          );

        // Changing an existing response always requires proving ownership of
        // the address, whichever way the RSVP was originally made.
        allow update: if
          (ownsRsvp(emailKey) && rsvpWindowOpen(eventId) && validRsvpPayload(emailKey)) ||
          isAdmin() || isEventOwner(eventId);

        allow delete: if isAdmin() || isEventOwner(eventId);
      }
    }
  }
}
